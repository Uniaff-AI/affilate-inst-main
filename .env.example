POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

HOST_DB_PORT=15432
HOST_API_PORT=14000
HOST_WEB_PORT=13000

DB_PORT=5432
API_PORT=4000
WEB_PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:${HOST_API_PORT}
INTERNAL_API_URL=http://api:${API_PORT}

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${DB_PORT}/${POSTGRES_DB}?schema=public

CHOKIDAR_USEPOLLING=true
